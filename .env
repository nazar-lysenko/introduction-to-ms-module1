RESOURCE_DB_URL=jdbc:postgresql://resource-db:5432/resource-db
RESOURCE_DB_NAME=resource-db
RESOURCE_DB_USER=postgres
RESOURCE_DB_PASSWORD=postgres
RESOURCE_DB_PORT=5432

SONG_DB_URL=jdbc:postgresql://song-db:5432/song-db
SONG_DB_NAME=song-db
SONG_DB_USER=postgres
SONG_DB_PASSWORD=postgres
SONG_DB_PORT=5433

SERVICE_REGISTRY_URL=http://service-registry:8761/eureka
SERVICE_REGISTRY_PORT=8761
SERVICE_REGISTRY_PREFER_IP=true

SERVICE_REGISTRY_CLIENT_FETCH_INTERVAL_SECONDS=5
SERVICE_REGISTRY_CLIENT_LEASE_RENEWAL_INTERVAL_SECONDS=5

API_GATEWAY_URL=http://api-gateway:8084
API_GATEWAY_PORT=8084
API_GATEWAY_CACHE_TTL=5s
API_GATEWAY_LOG_LEVEL=TRACE

AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=resources-bucket
AWS_ACCESS_KEY_ID=ms-fundamentals
AWS_SECRET_ACCESS_KEY=ms-fundamentals-secret

LOCALSTACK_SERVICES=s3

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RESOURCE_EVENTS=resource-events
KAFKA_CONSUMER_GROUP_ID=resource-processor
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICAS=1

KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=INTERNAL://:9092,CONTROLLER://:9093,EXTERNAL://:29092
KAFKA_ADVERTISED_LISTENERS=INTERNAL://kafka:9092,EXTERNAL://localhost:29092
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
