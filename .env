SERVICE_REGISTRY_PORT=8761
SERVICE_REGISTRY_PREFER_IP=true
SERVICE_REGISTRY_EMPTY_SYNC_WAIT_MS=0

SERVICE_REGISTRY_CLIENT_FETCH_INTERVAL_SECONDS=5
SERVICE_REGISTRY_CLIENT_LEASE_RENEWAL_INTERVAL_SECONDS=5

